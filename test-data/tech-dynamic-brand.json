{
  "schemaVersion": "1.0",
  "id": "tech-dynamic",
  "name": "Tech Dynamic Brand",
  "renderEngine": "remotion",
  "colors": {
    "primary": "#00D4FF",
    "accent": "#FF006E",
    "secondary": "#64748B",
    "background": "#0F172A"
  },
  "fonts": {
    "display": "Inter, sans-serif",
    "body": "Inter, sans-serif"
  },
  "compositions": {
    "player-intro-full": {
      "compositionId": "PlayerIntroFull",
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "duration": 30,
      "description": "30-second full player showcase"
    },
    "player-intro-short": {
      "compositionId": "PlayerIntroShort",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "duration": 8,
      "description": "8-second short-form player video"
    },
    "team-banner": {
      "compositionId": "TeamBanner",
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "duration": 15,
      "description": "15-second team roster showcase"
    }
  },
  "print": {
    "poster-16x20": {
      "script": "poster.psjs",
      "format": "poster",
      "width": 16,
      "height": 20,
      "unit": "inches",
      "dpi": 300,
      "colorSpace": "CMYK",
      "bleed": 0.125
    },
    "banner-2x6": {
      "script": "banner.psjs",
      "format": "banner",
      "width": 2,
      "height": 6,
      "unit": "inches",
      "dpi": 300,
      "colorSpace": "CMYK",
      "bleed": 0.125
    },
    "player-card-4x6": {
      "script": "card.psjs",
      "format": "card",
      "width": 4,
      "height": 6,
      "unit": "inches",
      "dpi": 300,
      "colorSpace": "CMYK",
      "bleed": 0.125
    }
  }
}
