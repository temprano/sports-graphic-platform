/**
 * Tech Dynamic Brand — Banner Print Template (Dynamic Sizing)
 * Photoshop UXP script for banner rendering
 * 
 * Configuration (injected by pipeline):
 * - printConfig: { width, height, unit, dpi, colorSpace, bleed, format }
 * - playerData: player name, number, position, photo, stats
 * - brandTokens: colors, fonts
 * - outputPath: PDF output location
 *
 * Output: 2x6 inches, CMYK PDF, 300 DPI, press-quality
 * Format: Vertical banner (narrow, tall)
 */

'use strict';

const { app, core, constants } = require('photoshop');
const { storage } = require('uxp');

// ─── Configuration injected by pipeline ────────────────────────
const config = typeof __printConfig !== 'undefined' ? __printConfig : {};
const p = typeof __playerData !== 'undefined' ? __playerData : null;
const tokens = typeof __brandTokens !== 'undefined' ? __brandTokens : {};
const outputPath = typeof __outputPath !== 'undefined' ? __outputPath : null;

if (!config.width || !config.height) throw new Error('banner.psjs: __printConfig missing width/height');
if (!p) throw new Error('banner.psjs: __playerData not injected');
if (!outputPath) throw new Error('banner.psjs: __outputPath not injected');

// ─── Utility: Convert inches to pixels ─────────────────────────
function inchesToPixels(inches, dpi) {
  return Math.round(inches * dpi);
}

// ─── Utility: Hex to RGB ──────────────────────────────────────
function hexToRgb(hex) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? {
    red:   parseInt(result[1], 16),
    green: parseInt(result[2], 16),
    blue:  parseInt(result[3], 16)
  } : { red: 255, green: 255, blue: 255 };
}

// ─── Document specs ───────────────────────────────────────────
const DPI = config.dpi || 300;
const DOC_WIDTH_PX = inchesToPixels(config.width, DPI);
const DOC_HEIGHT_PX = inchesToPixels(config.height, DPI);
const BLEED_PX = inchesToPixels(config.bleed || 0.125, DPI);
const SAFE_MARGIN_PX = inchesToPixels(0.125, DPI);  // 0.125" safe zone

// ─── Brand colors (with tech theme defaults) ─────────────────
const COLORS = {
  primary:    tokens.primary    || '#00D4FF',
  accent:     tokens.accent     || '#FF006E',
  secondary:  tokens.secondary  || '#64748B',
  background: tokens.background || '#0F172A',
  text:       tokens.text       || '#FFFFFF',
};

const FONTS = {
  heading: tokens.displayFont || 'Inter Bold',
  body:    tokens.bodyFont    || 'Inter',
};

// ─── Main render function ─────────────────────────────────────
async function buildBanner() {
  await core.executeAsModal(async () => {

    // 1. Create new CMYK document (2x6 vertical banner)
    const doc = await app.documents.add({
      width:      DOC_WIDTH_PX,
      height:     DOC_HEIGHT_PX,
      resolution: DPI,
      mode:       constants.ColorMode.CMYK,
      fill:       constants.DocumentFill.TRANSPARENT,
      name:       `banner_${config.width}x${config.height}_${p.slug || p.lastName}`,
    });

    // 2. Background layer (dark tech background)
    const bgLayer = doc.layers.add();
    bgLayer.name = 'Background';
    const bgColor = hexToRgb(COLORS.background);
    await bgLayer.fill(bgColor);

    // 3. Vertical accent stripe (left edge)
    const accentStripe = doc.layers.add();
    accentStripe.name = 'Accent Stripe';
    const stripeWidth = inchesToPixels(0.15, DPI);
    // Draw vertical stripe in primary color (full height)

    // 4. Top section: Team logo + team name
    const topLogoLayer = doc.layers.add();
    topLogoLayer.name = 'Team Section';
    const topHeight = inchesToPixels(1.5, DPI);
    // Logo (0.5" square, centered horizontally)
    // Team name below logo in body font

    // 5. Middle section: Player name + number (main content)
    const nameLayer = doc.layers.add();
    nameLayer.name = 'Player Name';
    const midHeight = inchesToPixels(3.5, DPI);
    // Player name (large, bold, in accent color)
    // Number below (smaller, in primary color)
    // Position tag (secondary color, small)

    // 6. Bottom section: Stats/QR code area
    const statsLayer = doc.layers.add();
    statsLayer.name = 'Stats/QR';
    const bottomHeight = inchesToPixels(1, DPI);
    // Top 1-2 stats (if available)
    // QR code placeholder (1cm square, right-aligned)

    // 7. Gradient overlay (subtle top-to-bottom)
    const gradLayer = doc.layers.add();
    gradLayer.name = 'Gradient Overlay';
    // Light gradient for depth

    // 8. Flatten and export as CMYK PDF
    await doc.flatten();
    
    const pdfOptions = {
      encoding: constants.PDFEncoding.ZIP,
      colorProfile: 'U.S. Web Coated (SWOP) v2',
    };

    // Get file for saving
    const fs = await storage.localFileSystem.getFileForSaving(outputPath, {
      types: ['pdf']
    });

    await doc.exportFile(fs, constants.ExportFormat.PDF, pdfOptions);

    console.log(`✅ Banner ${config.width}x${config.height} rendered to ${outputPath}`);
    await doc.closeWithoutSaving();

  }, { commandName: `Build Banner ${config.width}x${config.height}` });
}

// Execute
buildBanner().catch(err => {
  console.error(`banner.psjs failed: ${err.message}`);
  throw err;
});
