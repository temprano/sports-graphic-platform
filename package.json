{
  "name": "sports-graphics-platform",
  "version": "0.1.0",
  "description": "Automated AI-driven sports team photo and print fulfillment platform",
  "type": "module",
  "private": true,
  "workspaces": [
    "components-1-customer-web",
    "."
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently npm:dev:web npm:dev:pipeline",
    "dev:web": "npm -w @sports-graphics/web-app run dev",
    "dev:pipeline": "nodemon --watch src src/queue/worker.js",
    "build": "npm run build:web && npm run build:pipeline",
    "build:web": "npm -w @sports-graphics/web-app run build",
    "build:pipeline": "echo 'Pipeline is ESM, no build needed'",
    "start": "npm start -w @sports-graphics/web-app",
    "worker": "node src/queue/worker.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:web": "npm test -w @sports-graphics/web-app",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "setup:appwrite": "node scripts/setup-appwrite.js"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "gsap": "^3.12.0",
    "next": "^14.0.0",
    "node-appwrite": "^21.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "redis": "^4.6.0",
    "stripe": "^14.0.0",
    "transformers": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "autoprefixer": "^10.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.0.0",
    "nodemon": "^3.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "vitest": "^1.0.0"
  }
}
