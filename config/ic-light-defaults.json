{
  "schemaVersion": "1.0",
  "description": "Default IC-Light settings for all brands. Can be overridden per brand in brand.json.",
  "lighting": {
    "direction": {
      "label": "Light direction (azimuth in degrees, 0-360)",
      "value": 45,
      "min": 0,
      "max": 360,
      "description": "0=front, 90=left, 180=back, 270=right"
    },
    "intensity": {
      "label": "Light intensity (0-1 scale)",
      "value": 0.8,
      "min": 0.1,
      "max": 1.0,
      "description": "0.1=very subtle, 0.8=strong, 1.0=very intense"
    },
    "colorTemperature": {
      "label": "Light color temperature (Kelvin)",
      "value": 5500,
      "min": 2700,
      "max": 6500,
      "description": "2700K=warm (sunset), 5500K=daylight, 6500K=cool (bluish)"
    }
  },
  "presets": {
    "soft_front": {
      "name": "Soft Front Lighting",
      "description": "Gentle, flattering light from front-left",
      "lighting": {
        "direction": { "value": 30 },
        "intensity": { "value": 0.6 },
        "colorTemperature": { "value": 5200 }
      }
    },
    "dramatic_side": {
      "name": "Dramatic Side Lighting",
      "description": "Strong light from left side, high contrast",
      "lighting": {
        "direction": { "value": 90 },
        "intensity": { "value": 0.95 },
        "colorTemperature": { "value": 5500 }
      }
    },
    "warm_fill": {
      "name": "Warm Fill Light",
