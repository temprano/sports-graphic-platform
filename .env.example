# Sports Graphics Platform — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Appwrite ────────────────────────────────────────────────────────────────
# Dev: Appwrite Cloud (https://cloud.appwrite.io)
# Prod: Self-hosted on VPS (http://your-vps-ip/v1)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Appwrite Storage Bucket IDs (created by scripts/setup-appwrite.js)
APPWRITE_BUCKET_UPLOADS=        # customer photo uploads (pipeline access only)
APPWRITE_BUCKET_PROOFS=         # watermarked proof assets (signed URL access)
APPWRITE_BUCKET_FINALS=         # final deliverable assets (single-use download)
APPWRITE_BUCKET_PREVIEWS=       # parent store product preview images

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Use test keys (sk_test_...) for dev, live keys (sk_live_...) for prod
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_    # from Stripe Dashboard > Webhooks

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                 # leave empty for local dev

# ─── ComfyUI ─────────────────────────────────────────────────────────────────
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_API_KEY=                # if ComfyUI auth is enabled

# ─── Prodigi (Print Fulfillment) ─────────────────────────────────────────────
PRODIGI_API_KEY=
PRODIGI_API_URL=https://api.prodigi.com/v4.0

# ─── Printful (Backup Fulfillment) ───────────────────────────────────────────
PRINTFUL_API_KEY=
PRINTFUL_API_URL=https://api.printful.com

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Paths ───────────────────────────────────────────────────────────────────
BRANDS_PATH=./components/3-asset-generation/brands
ORDERS_TEMP_PATH=./tmp/orders   # local working directory for pipeline jobs

# ─── Security ────────────────────────────────────────────────────────────────
# Proof URL signed token expiry in seconds (default 900 = 15 minutes)
PROOF_URL_EXPIRY_SECONDS=900
# Final download link expiry in seconds (default 172800 = 48 hours)
DOWNLOAD_EXPIRY_SECONDS=172800
